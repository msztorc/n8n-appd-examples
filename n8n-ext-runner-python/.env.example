N8N_VERSION=2.45.5
N8N_HTTP_PORT=5678
N8N_APPDYNAMICS_BT_NAME_TEMPLATE=n8n/{workflow_name}/{node_name}
N8N_APPDYNAMICS_CORRELATION_ENABLED=true
APPD_INIT_IMAGE=docker.io/appdynamics/nodejs-agent:latest
APPD_PYTHON_PROXY_IMAGE=docker.io/appdynamics/dl-proxy:26.7.2

APPDYNAMICS_AGENT_ACCOUNT_NAME=
APPDYNAMICS_AGENT_ACCOUNT_ACCESS_KEY=
APPDYNAMICS_CONTROLLER_HOST_NAME=
APPDYNAMICS_CONTROLLER_PORT=443
APPDYNAMICS_CONTROLLER_SSL_ENABLED=true
APPDYNAMICS_LOGGER_OUTPUT_TYPE=console
APPDYNAMICS_AGENT_APPLICATION_NAME=n8n-ext-runner-python
APPDYNAMICS_AGENT_TIER_NAME=n8n-node
APPDYNAMICS_AGENT_NODE_NAME=n8n-node
APPDYNAMICS_AGENT_REUSE_NODE_NAME_PREFIX=n8n-node

# Python runner and proxy settings use container paths and their shared namespace.
APPDYNAMICS_AGENT_REUSE_NODE_NAME=true
APPDYNAMICS_CONTROLLER_SSL_CERTFILE=/opt/certs/corporate-ca.pem
APPDYNAMICS_TCP_COMM_HOST=127.0.0.1
APPDYNAMICS_TCP_COMM_PORT=9091
APPDYNAMICS_TCP_PORT_RANGE=10000-10100
APPDYNAMICS_LOGS_DIR=/tmp/appd/logs
APPDYNAMICS_LOGGING_LEVEL=info

# Empty overrides share the standard prefix/tier.
N8N_APPDYNAMICS_TASK_RUNNER_REUSE_NODE_NAME_PREFIX=
N8N_APPDYNAMICS_TASK_RUNNER_TIER_NAME=n8n-runner

# Generated by setup-env.js; keep stable across restarts.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
