# Matching n8n and runners versions; do not use "stable" for just one image.
N8N_VERSION=2.45.5
N8N_HTTP_PORT=5678
APPD_INIT_IMAGE=docker.io/appdynamics/nodejs-agent:latest

APPDYNAMICS_AGENT_ACCOUNT_NAME=
APPDYNAMICS_AGENT_ACCOUNT_ACCESS_KEY=
APPDYNAMICS_CONTROLLER_HOST_NAME=
APPDYNAMICS_CONTROLLER_PORT=443
APPDYNAMICS_CONTROLLER_SSL_ENABLED=true
APPDYNAMICS_LOGGER_OUTPUT_TYPE=console
APPDYNAMICS_AGENT_APPLICATION_NAME=n8n-ext-runner-nodejs
APPDYNAMICS_AGENT_TIER_NAME=n8n-node
APPDYNAMICS_AGENT_NODE_NAME=n8n-node
APPDYNAMICS_AGENT_REUSE_NODE_NAME_PREFIX=n8n-node

# Empty runner overrides share the standard prefix/tier.
N8N_APPDYNAMICS_TASK_RUNNER_REUSE_NODE_NAME_PREFIX=
N8N_APPDYNAMICS_TASK_RUNNER_TIER_NAME=n8n-runner
# Local-only instrumentation; the launcher config uses insecure JavaScript mode.
N8N_APPDYNAMICS_RUNNER_ENABLED=true

# Generated by setup-env.js; keep stable across restarts.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
